{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "productName": "Balcao PDV",
  "version": "0.1.0",
  "identifier": "com.example.balcaopdv",
  "app": {
    "windows": [
      {
        "title": "Balcão PDV",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "maximized": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "default": {
        "path": "pdv.db",
        "type": "sqlite"
      }
    }
  }
}
