# Modelo do .env. Copie para .env e ajuste. O .env nunca vai para o git.
# Os valores abaixo já funcionam com um PostgreSQL local (usuário/senha postgres).

PORT=4444

DB_USER=postgres
DB_HOST=localhost
DB_NAME=balcao_pdv
DB_PASSWORD=postgres
DB_PORT=5432

# Assinatura do token de sessão dos operadores. Mínimo de 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# O valor abaixo serve SÓ para rodar localmente.
JWT_SECRET=troque-este-segredo-local-de-desenvolvimento-0001
JWT_EXPIRES_IN=12h

# Origens liberadas no CORS (separadas por vírgula). O padrão cobre o Vite em
# modo dev (http://localhost:1420) e o app empacotado pelo Tauri.
CORS_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost

# Maquininha Mercado Pago Point. O access token fica na tabela empresa
# (token_api) e o id do terminal na tabela caixa (terminal_id).
#   auto = usa a API real quando a loja e o caixa têm token e terminal, e o
#          simulador quando não têm (padrão)
#   mock = sempre simula     real = nunca simula
MERCADO_PAGO_MODE=auto
# Tempo até o simulador "aprovar" a cobrança na maquininha.
MOCK_PAYMENT_DELAY_MS=6000

# Número (com DDI e DDD, só dígitos) impresso como QR code de atendimento no
# comprovante. Vazio = sem QR.
RECEIPT_WHATSAPP=
