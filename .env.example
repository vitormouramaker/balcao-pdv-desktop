# Front (Vite). Copie para .env.local se precisar mudar algo.

# Endereço da API do PDV.
VITE_API_BASE_URL=http://localhost:4444

# Caixa e loja usados quando o app roda no navegador (sem o Tauri não existe o
# arquivo Documentos/pdv/config.json). Os dados de demonstração criam a loja 1
# com os caixas 1 e 2.
VITE_DEFAULT_CAIXA=1
VITE_DEFAULT_FILIAL=1
